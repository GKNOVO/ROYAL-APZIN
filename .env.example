# ─────────────────────────────────────────────────────────────
#  ORG Royal AP · configuração do bot
#  Copie este arquivo para ".env" e preencha.
#  Na hospedagem (Discloud, Render, VPS) cadastre estas mesmas
#  variáveis no painel — NUNCA suba o .env para o GitHub.
#  Todos os IDs abaixo são FICTÍCIOS (só exemplo de formato).
# ─────────────────────────────────────────────────────────────

# 1) OBRIGATÓRIO: token do bot (Developer Portal → Bot → Reset Token → Copy)
#    Uma linha só, sem espaços e sem aspas.
DISCORD_TOKEN=COLE_SEU_TOKEN_AQUI

# 2) Opcional: ID da aplicação (vazio = o bot descobre sozinho pelo token)
CLIENT_ID=123456789012345678

# 3) Opcional: ID do servidor. Preenchido = comandos aparecem na hora
#    Vazio = comandos globais (podem levar até 1 hora)
GUILD_ID=123456789012345678

# 4) Banco de dados SQLite (o bot cria o arquivo e a pasta)
DATABASE_PATH=database/royal.db

# 5) Porta do servidor de saúde (Discloud/Render definem sozinhos)
PORT=3000

# 6) ── FILAS ────────────────────────────────────────────────
#    CANAL DE REFERÊNCIA das filas: o canal de cada fila é criado
#    logo ABAIXO deste canal (não é categoria).
#    Também dá para definir no Discord com /boombot setfila
CANAL_FILA_ID=123456789012345678
# Compatibilidade: categoria onde as salas privadas de AP são criadas
CATEGORIA_FILAS_ID=123456789012345678

# 7) ── TICKETS ──────────────────────────────────────────────
#    TICKET_CANAL_ID = CANAL DE REFERÊNCIA dos tickets: o canal do
#    ticket nasce logo ABAIXO dele e NENHUMA mensagem é enviada no
#    chat — o jogador só vê o aviso temporário (com o botão
#    "Ignorar mensagem").
#    Também dá para definir com /boombot setticket
TICKET_CANAL_ID=123456789012345678
# Alternativas aceitas (canal de texto ou, no modo antigo, categoria):
TICKET_DESTINO_ID=
TICKET_CATEGORIA_ID=
CATEGORY_TICKETS_ID=
CATEGORIA_SUPORTE_ID=

# 8) IDs dos cargos (ativar "Copiar ID" nas configurações do Discord)
CARGO_ADMIN_ID=123456789012345678
CARGO_STAFF_ID=123456789012345678
CARGO_MEDIADOR_ID=123456789012345678

# 9) Canal de auditoria/logs (pode definir depois com /logs)
CANAL_LOGS_ID=123456789012345678

# 10) Comissão do mediador (0.05 = 5%)
COMISSAO_PADRAO=0.05

# 11) Nome da moeda da loja
MOEDA=Royal Coin

# 12) ── NIX FF (salas automáticas) ──────────────────────────
#    Chave gerada em https://nixff.vip (Dashboard → API).
#    Sem ela o bot continua online normalmente; só o /nix avisa que falta.
NIX_API_URL=https://salas.nixbot.vip
NIX_API_KEY=COLE_SUA_CHAVE_NIX_AQUI
