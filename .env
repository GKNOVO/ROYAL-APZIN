# ═════════════════════════════════════════════════════════════
#  ORG Royal AP · .env  (modelo VAZIO, pronto para preencher)
#
#  Este arquivo não tem nenhum segredo. Cole os seus IDs/token.
#
#  ⚠️ CUIDADO: se você preencher token/chave AQUI e der push, eles
#     vão para o GitHub. Na Discloud/Render prefira cadastrar tudo
#     em "Variáveis de ambiente" do painel do app.
#
#  Como pegar um ID no Discord: Configurações → Avançado →
#  "Modo desenvolvedor" ligado → botão direito no canal/cargo →
#  "Copiar ID".
# ═════════════════════════════════════════════════════════════

# 1) OBRIGATÓRIO ─ token do bot
#    Developer Portal → seu app → Bot → Reset Token → Copy
#    Uma linha só, sem espaços e sem aspas.
DISCORD_TOKEN=

# 2) ID da aplicação (pode ficar vazio: o bot descobre pelo token)
CLIENT_ID=

# 3) ID do servidor — preenchido, os 49 comandos aparecem na hora
#    Vazio = comandos globais (podem levar até 1 hora)
GUILD_ID=

# 4) Banco de dados SQLite (o bot cria o arquivo e a pasta)
DATABASE_PATH=database/royal.db

# 5) Porta do servidor de saúde (Discloud/Render definem sozinhos)
PORT=3000

# 6) Categoria onde as salas privadas de AP são criadas
CATEGORIA_FILAS_ID=

# 7) ── TICKETS ──────────────────────────────────────────────
#    Pode colocar o ID de uma CATEGORIA **ou** de um CANAL DE TEXTO.
#    • Categoria → o ticket nasce dentro dela.
#    • Canal     → o ticket nasce na mesma categoria desse canal e o
#                  bot manda o link do ticket no próprio canal.
#    Basta preencher UMA destas linhas (a de cima manda).
TICKET_DESTINO_ID=
TICKET_CATEGORIA_ID=
TICKET_CANAL_ID=
# Nomes antigos, continuam aceitos (podem receber categoria OU canal):
CATEGORY_TICKETS_ID=
CATEGORIA_SUPORTE_ID=
# Avisar no canal de atendimento quando um ticket for aberto (true/false)
TICKET_AVISO_CANAL=true

# 8) IDs dos cargos
CARGO_ADMIN_ID=
CARGO_STAFF_ID=
CARGO_MEDIADOR_ID=

# 9) Canal de auditoria/logs (pode definir depois com /logs)
CANAL_LOGS_ID=

# 10) Comissão do mediador (0.05 = 5%)
COMISSAO_PADRAO=0.05

# 11) Nome da moeda da loja
MOEDA=Royal Coin

# 12) ── NIX FF (salas automáticas) ──────────────────────────
#    Chave gerada em https://nixff.vip (Dashboard → API).
#    Sem ela o bot fica online normalmente; só o /nix avisa que falta.
NIX_API_URL=https://salas.nixbot.vip
NIX_API_KEY=
