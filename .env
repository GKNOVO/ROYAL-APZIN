# ─────────────────────────────────────────────────────────────
#  ORG Royal AP · configuração do bot
#  Preencha só o que tem valor. Linha vazia = o bot usa o padrão.
# ─────────────────────────────────────────────────────────────

# 1) OBRIGATÓRIO: token do bot (Developer Portal → Bot → Reset Token → Copy)
DISCORD_TOKEN=MTU2OTUzMzk2NzEzOTYwMjUwMg.G35pH0.tvYOjXTXR0sJ1dowo2sO89QKx_zJIBzFYEbCfw

# 2) Opcional: ID da aplicação (se vazio, o bot descobre sozinho pelo token)
CLIENT_ID=1569533967139602502

# 3) Opcional: ID do servidor. Preenchido = comandos aparecem na hora.
#    Vazio = comandos globais (podem levar até 1 hora para aparecer).
GUILD_ID=1543683482708877312

# 4) Banco de dados SQLite (não precisa criar o arquivo, o bot cria)
DATABASE_PATH=database/royal.db

# 5) IDs de categoria onde as salas privadas de AP são criadas
CATEGORIA_FILAS_ID=1543683925686226954
CATEGORIA_SUPORTE_ID=1543683921898774658

# 6) IDs dos cargos (ativar "Copiar ID" nas configurações do Discord)
CARGO_ADMIN_ID=1543683890831687830
CARGO_STAFF_ID=1543684107790327879
CARGO_MEDIADOR_ID=1543684028719173732

# 7) Canal de auditoria/logs (pode definir depois com /logs)
CANAL_LOGS_ID=1543684069735530496

# 8) Comissão do mediador (0.05 = 5% do valor da aposta)
COMISSAO_PADRAO=0.05

# 9) Nome da moeda da loja
MOEDA=Royal Coin
