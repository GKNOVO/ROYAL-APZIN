# ═════════════════════════════════════════════════════════════
#  ORG Royal AP · .env  (modelo VAZIO — preencha e salve)
#
#  Nenhum token, ID ou chave vem preenchido aqui de propósito.
#  ⚠️ Se você preencher isso e der push, os segredos vão para o
#     GitHub. Na Discloud/Render prefira o painel "Variáveis".
#
#  Pegar um ID: Discord → Configurações → Avançado → Modo
#  desenvolvedor → botão direito no canal/cargo → Copiar ID.
# ═════════════════════════════════════════════════════════════

# 1) OBRIGATÓRIO ─ token do bot (Developer Portal → Bot → Reset Token)
#    Uma linha só, sem espaços e sem aspas.
DISCORD_TOKEN=MTU2OTUzMzk2NzEzOTYwMjUwMg.G8K9n8.0adjDcN_hRyPXhPl2_7WRVdsh3N3Ceq_2K4x4A

# 2) ID da aplicação (vazio = o bot descobre sozinho pelo token)
CLIENT_ID=1569533967139602502

# 3) ID do servidor (preenchido = comandos aparecem na hora)
GUILD_ID=1543683482708877312

# 4) Banco de dados SQLite
DATABASE_PATH=database/royal.db

# 5) Porta do servidor de saúde (Discloud/Render definem sozinhos)
PORT=3000

# 6) ── FILAS ────────────────────────────────────────────────
#    CANAL DE REFERÊNCIA: o canal de cada fila nasce logo ABAIXO
#    deste canal (não é categoria). Também dá para definir no
#    Discord com /boombot setfila
CANAL_FILA_ID=1543685635590586378
# Compatibilidade: categoria onde as salas privadas de AP nascem
CATEGORIA_FILAS_ID=

# 7) ── TICKETS ──────────────────────────────────────────────
#    TICKET_CANAL_ID = CANAL DE REFERÊNCIA: o ticket nasce logo
#    ABAIXO dele e NADA é enviado no chat (só o aviso temporário
#    para quem abriu). Também dá para definir com /boombot setticket
TICKET_CANAL_ID=1543684149523783770
# Alternativas aceitas (canal de texto ou, no modo antigo, categoria):
TICKET_DESTINO_ID=
TICKET_CATEGORIA_ID=
CATEGORY_TICKETS_ID=
CATEGORIA_SUPORTE_ID=

# 8) IDs dos cargos
CARGO_ADMIN_ID=1543683890831687830
CARGO_STAFF_ID=1543684107790327879
CARGO_MEDIADOR_ID=1543684028719173732

# 9) Canal de auditoria/logs
CANAL_LOGS_ID=1543684069735530496

# 10) Comissão do mediador (0.05 = 5%)
COMISSAO_PADRAO=0.05

# 11) Nome da moeda da loja
MOEDA=Royal Coin

# 12) ── NIX FF (salas automáticas) ──────────────────────────
NIX_API_URL=https://salas.nixbot.vip
NIX_API_KEY=nix_sk_f400c02a51376b9720aea7e9e879c48b1fcfe1385a786ec6
